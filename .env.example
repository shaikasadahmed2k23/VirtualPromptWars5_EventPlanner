# Copy to `.env` (next to this file) and fill in. `.env` is git-ignored and is
# read ONLY by the server, via Node's --env-file flag in the npm scripts.
# Never prefix secrets with VITE_: anything prefixed VITE_ is bundled into the browser.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to run Utsav in "Demo mode" with realistic, input-aware sample plans.
GEMINI_API_KEY=

# Gemini model used by the AI proxy. Defaults to the current stable Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Port for the Express server (API, plus the built SPA after `npm run build`).
PORT=8787

# Optional comma-separated origins allowed to call the API cross-origin.
# Same-origin requests (the bundled SPA, or Vite's dev proxy) never need this.
ALLOWED_ORIGIN=
